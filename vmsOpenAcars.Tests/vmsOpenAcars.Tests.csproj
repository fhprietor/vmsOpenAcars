  <ItemGroup>
    <!--
      The scoring engine under test lives in the WinExe application assembly. The
      ProjectReference exists only to force build ORDER: the app must be compiled before
      the tests can bind to its output. ReferenceOutputAssembly=false stops MSBuild from
      treating the exe as a normal assembly reference, which would fight with the explicit
      <Reference> below.
    -->
    <ProjectReference Include="..\vmsOpenAcars\vmsOpenAcars.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="vmsOpenAcars">
      <HintPath>..\vmsOpenAcars\bin\$(Configuration)\vmsOpenAcars.exe</HintPath>
      <!-- Must be copied: the test host has to resolve the assembly under test at
           runtime, not just at compile time. -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>
