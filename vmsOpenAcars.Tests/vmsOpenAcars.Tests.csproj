  <ItemGroup>
    <!-- Los idiomas, junto al `.exe` de pruebas: `LocalizationService` los busca en
         `Application.StartupPath` y sin ellos `L._(clave)` devuelve `[[clave]]`, así que cualquier
         prueba que mire un rótulo traducido —los del análisis del aterrizaje, p. ej.— medía el
         marcador de depuración en vez del texto. Se copian del proyecto del cliente para no tener
         dos copias que se puedan separar. -->
    <Content Include="..\vmsOpenAcars\Languages\es.json">
      <Link>Languages\es.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\vmsOpenAcars\Languages\en.json">
      <Link>Languages\en.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
