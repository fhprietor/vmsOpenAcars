<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="language" value="es" />
    <!-- Plantilla distribuible: sin credenciales ni datos de aerolínea concreta.
         El piloto introduce su API URL y API Key de phpVMS en SETTINGS tras desplegar.
         La clave de NavData NO se configura: llega en el sobre cifrado de phpVMS. -->
    <add key="vms_api_url" value="your_phpvms_url" />
    <add key="airline" value="" />
    <add key="vms_api_key" value="your_phpvms_apikey" />
    <add key="simbrief_user" value="your_simbrief_user" />
    <!-- Polling configuration -->
    <add key="polling_interval_ms" value="50" />

    <!-- Position update intervals by phase (seconds) -->
    <add key="update_interval_taxi" value="30" />
    <add key="update_interval_takeoff" value="5" />
    <add key="update_interval_climb" value="15" />
    <add key="update_interval_cruise" value="30" />
    <add key="update_interval_descent" value="15" />
    <add key="update_interval_approach" value="5" />
    <add key="update_interval_other" value="30" />

    <!-- Event reporting -->
    <add key="report_gear_changes" value="true" />
    <add key="report_flap_changes" value="true" />
    <add key="report_spoiler_changes" value="true" />
    <add key="report_light_changes" value="true" />
    <add key="report_engine_changes" value="true" />

    <!-- NavData API — la `url` la proporciona la aerolínea virtual; sirve de respaldo de la base
         cuando el sobre de phpVMS no trae la suya y para el botón TEST de Settings.
         `navdata_api_domain` es opcional: si se deja vacío se deriva del host de vms_api_url.

         `navdata_api_key`: ELIMINADA (era `your_navdata_apikey`). La clave ya no se configura en
         ningún sitio: phpVMS la entrega cifrada en `GET {vms_api_url}/api/navdata` con la cabecera
         X-API-KEY (derivada de la vms_api_key del piloto) y el cliente la guarda solo en memoria.
         Escribirla aquí NO sirve: se ignora. Era la misma clave que se filtró publicada en este
         fichero, y su respaldo escondía que el sobre dejara de funcionar. -->
    <add key="navdata_api_url" value="your_navdata_api_url" />
    <add key="navdata_api_domain" value="" />

    <!-- CARTO basemaps (teselas del mapa). Clave gratis en https://carto.com/basemaps/apikey/ ,
         SIN restricción de web (una app de escritorio no envía Referer y CARTO responde 403).
         La decide quien distribuye: es un token publicable, no un secreto, pero cuenta contra su
         cuota de teselas. Vacía = mapa con la marca de agua «API key required». -->
    <add key="carto_api_key" value="" />

    <!-- Fuel tolerances -->
    <add key="fuel_tolerance_percent" value="10" />
    <add key="fuel_tolerance_absolute" value="50" />

    <!-- Observación de la ruta de rodaje PROPUESTA (`planned`).
         APAGADA a propósito: el validador de ingesta de NavData rechaza hoy ese cuerpo por
         `missing_stand` (no lleva `stand`) y `route_too_short` (`route` exige >=2 calles y la
         propuesta no puede ir en `route`). Se enciende a true —sin recompilar— el día que
         NavData publique su almacén `TaxiRoutePlanned`. Si la clave falta o está mal escrita,
         el cliente la trata como false. -->
    <add key="taxi_planned_observation_enabled" value="false" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>